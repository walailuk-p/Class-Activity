rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Courses collection
    match /courses/{courseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.instructorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.instructorId == request.auth.uid;
    }

    // Students roster collection (Teacher private)
    match /students/{studentDocId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Isolated Student Lookup (get single student by exact key: courseId_studentId)
    // List is forbidden to prevent scraping entire student rosters!
    match /rosterLookup/{lookupId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Assignments
    match /assignments/{assignmentId} {
      // Students need to read assignment details and query by 6-digit code
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.instructorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.instructorId == request.auth.uid;
    }

    // Submissions
    match /submissions/{submissionId} {
      // Single submission can be retrieved by student using their submission key (assignmentId_studentId)
      allow get: if true;
      // Listing submissions is restricted to instructors to protect student privacy
      allow list: if isSignedIn();
      
      // Creating or updating submission by student
      allow create: if isValidId(submissionId)
        && request.resource.data.assignmentId is string
        && request.resource.data.studentId is string
        && request.resource.data.receiptId is string;

      allow update: if (
        isSignedIn() || (
          // Student updating before deadline
          request.resource.data.assignmentId is string
          && request.resource.data.studentId is string
          && request.resource.data.assignmentId == resource.data.assignmentId
          && request.resource.data.studentId == resource.data.studentId
        )
      );

      allow delete: if isSignedIn();
    }
  }
}
